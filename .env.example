# Copy to .env.local and adjust. Never commit real secrets.
# Only NEXT_PUBLIC_* values reach the browser; everything else stays on the server.

# Public base URL, used for metadata and absolute links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Server only ---
# PostgreSQL connection string. Read only by server/env.ts and drizzle.config.ts.
# Managed hosts usually need ?sslmode=require.
DATABASE_URL=postgres://nerio:nerio@localhost:5432/nerio
# Max pool connections per server instance.
DATABASE_POOL_MAX=10

# Sign in with Google (optional; the button is hidden until both are set).
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application).
# Authorized redirect URI: <NEXT_PUBLIC_APP_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Chapter ZIP ingestion limits and private local storage provider.
CHAPTER_ZIP_MAX_BYTES=262144000
CHAPTER_IMAGE_MAX_BYTES=41943040
CHAPTER_IMAGE_MIN_WIDTH=400
CHAPTER_IMAGE_MIN_HEIGHT=500
CHAPTER_IMAGE_MAX_WIDTH=12000
CHAPTER_IMAGE_MAX_HEIGHT=40000
CHAPTER_ARCHIVE_MAX_ENTRIES=500
CHAPTER_ARCHIVE_MAX_EXPANDED_BYTES=1000000000
NERIO_STORAGE_DIR=./private-storage

# Translation providers: mock for local architecture checks, or OpenAI-compatible JSON APIs.
OCR_PROVIDER=mock
TRANSLATION_PROVIDER=mock
AI_API_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
OCR_MODEL=gpt-4o-mini
TRANSLATION_MODEL=gpt-4o-mini
OCR_CONFIDENCE_MIN=0.65
TRANSLATION_CONFIDENCE_MIN=0.65
