# Copy to .env.local and adjust. Never commit real secrets.
# Only NEXT_PUBLIC_* values reach the browser; everything else stays on the server.

# Public base URL, used for metadata and absolute links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Server only ---
# PostgreSQL connection string. Read only by server/env.ts and drizzle.config.ts.
# Managed hosts usually need ?sslmode=require.
DATABASE_URL=postgres://nerio:nerio@localhost:5432/nerio
# Max pool connections per server instance.
DATABASE_POOL_MAX=10

# Sign in with Google (optional; the button is hidden until both are set).
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application).
# Authorized redirect URI: <NEXT_PUBLIC_APP_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Chapter ZIP ingestion limits and private local storage provider.
CHAPTER_ZIP_MAX_BYTES=262144000
CHAPTER_IMAGE_MAX_BYTES=41943040
CHAPTER_IMAGE_MIN_WIDTH=64
CHAPTER_IMAGE_MIN_HEIGHT=16
CHAPTER_IMAGE_MAX_WIDTH=20000
CHAPTER_IMAGE_MAX_HEIGHT=120000
CHAPTER_ARCHIVE_MAX_ENTRIES=1500
CHAPTER_ARCHIVE_MAX_EXPANDED_BYTES=1000000000
NERIO_STORAGE_DIR=./private-storage

# OCR: tesseract = local open-source OCR (default, free, no key); openai_compatible = optional paid vision model; mock = fake.
OCR_PROVIDER=tesseract
# Tesseract language data is downloaded once into this folder; set TESSERACT_LANG_PATH to a folder of *.traineddata to stay offline.
TESSERACT_CACHE_DIR=./.cache/tesseract
TESSERACT_LANG_PATH=
OCR_MIN_WORD_CONFIDENCE=50
# Manual translation workflow (Admin → Batch translate). No translation API is ever called by it.
OCR_JOB_CONCURRENCY=2
OCR_WORKERS=2
FINALIZE_CONCURRENCY=2
AUTO_PUBLISH_TRANSLATED_CHAPTERS=false
MANUAL_TRANSLATION_AUTO_APPROVE=true
# AI workflow (Admin → Upload) only: machine translation provider.
TRANSLATION_PROVIDER=mock
AI_API_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
# Use a strong vision model for OCR and a strong multilingual model for translation (mini models misread
# lettering and write unnatural Mongolian).
OCR_MODEL=gpt-4o-mini
TRANSLATION_MODEL=gpt-4o-mini
OCR_CONFIDENCE_MIN=0.65
TRANSLATION_CONFIDENCE_MIN=0.65
AI_MAX_CONCURRENCY=4
TRANSLATION_JOB_CONCURRENCY=2
# local erases lettering from detected balloons; http_json calls IMAGE_CLEANUP_URL; mock leaves pages untouched.
IMAGE_CLEANUP_PROVIDER=local
IMAGE_CLEANUP_URL=
TYPESET_MIN_FONT_SIZE=12
TYPESET_MAX_FONT_SIZE=36
TYPESET_LINE_HEIGHT=1.18
TYPESET_BUBBLE_PADDING=0.1
TYPESET_ALIGNMENT=center
